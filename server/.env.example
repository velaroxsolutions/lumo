# Where lumo.db lives (mount a volume here in production)
DATA_DIR=.
# Comma-separated browser origins allowed to call the API.
# Not needed when the web app is served by this server (FRONTEND_DIST) or for the phone apps.
CORS_ORIGINS=http://localhost:8081
# Serve the built web app (npx expo export --platform web) from this server, same origin.
FRONTEND_DIST=
# Enables GET /admin/metrics when set; send it as the X-Admin-Token header
LUMO_ADMIN_TOKEN=
# Sessions expire after this many days without use
SESSION_TTL_DAYS=180

# Password-reset email (stdlib smtplib). Leave SMTP_HOST empty to send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Development only: print emails to the server log instead of sending them.
# LUMO_MAIL=log
